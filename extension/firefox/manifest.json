{
  "manifest_version": 2,
  "name": "Klarkey",
  "version": "0.1.0",
  "description": "Desktop-only autofill bridge for Klarkey.",
  "permissions": ["activeTab", "tabs", "nativeMessaging", "storage", "privacy", "https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "browser_action": {
    "default_title": "Klarkey",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_security_policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; connect-src 'none'; form-action 'none'; worker-src 'self'",
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": ["page-bridge.js", "icons/klarkey-128.png"],
  "browser_specific_settings": {
    "gecko": {
      "id": "klarkey@example.local"
    }
  },
  "icons": {
    "128": "icons/klarkey-128.png"
  }
}
