{
  "manifest_version": 3,
  "name": "Klarkey",
  "version": "0.1.0",
  "key": "",
  "description": "Desktop-only autofill bridge for Klarkey.",
  "permissions": ["activeTab", "tabs", "nativeMessaging", "webAuthenticationProxy"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Klarkey",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js", "icons/klarkey-128.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "128": "icons/klarkey-128.png"
  }
}
