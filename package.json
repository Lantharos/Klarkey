{
  "name": "klarkey",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-browser-extension.mjs",
    "build:extension": "node scripts/build-browser-extension.mjs",
    "bundle:extension": "bun build extension/shared/background/index.js --outfile=extension/shared/background.js --target=browser ; bun build extension/shared/content/index.js --outfile=extension/shared/content.js --target=browser",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "bun run lint && bun run test && bun run build",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "bun run rebuild",
    "dev:desktop": "electron . --dev",
    "devweb": "vite"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "jsqr": "^1.4.0",
    "koffi": "^2.16.1",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "otpauth": "^9.5.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.2.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.4",
    "wait-on": "^9.0.5"
  },
  "main": "dist-electron/main.js",
  "overrides": {
    "follow-redirects": "^1.15.12"
  },
  "trustedDependencies": [
    "koffi"
  ]
}
