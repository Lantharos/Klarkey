{
  "name": "klarkey",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && bun run build:extension",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:extension": "node scripts/build-browser-extension.mjs",
    "bundle:extension": "bun build extension/shared/background/index.js --outfile=extension/shared/background.js --target=browser ; bun build extension/shared/content/index.js --outfile=extension/shared/content.js --target=browser",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "bun run lint && bun run test && bun run build",
    "dev:desktop": "bun run tauri dev",
    "devweb": "vite",
    "verify:desktop-release": "node scripts/verify-desktop-release.mjs",
    "verify:extension": "node scripts/verify-browser-extension.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@ave-id/sdk": "^0.8.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "clsx": "^2.1.1",
    "convex": "^1.37.0",
    "fflate": "^0.8.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "otpauth": "^9.5.0",
    "postcss": "^8.5.13",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tldts": "^7.0.30",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2.11.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.5"
  },
  "overrides": {
    "follow-redirects": "^1.15.12"
  }
}
