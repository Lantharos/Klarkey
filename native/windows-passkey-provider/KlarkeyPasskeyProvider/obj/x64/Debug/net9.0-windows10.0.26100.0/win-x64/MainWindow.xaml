<?xml version="1.0" encoding="utf-8" ?>
<Window x:ConnectionId='1'
    x:Class="KlarkeyPasskeyProvider.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:ConnectionId='2'
            x:Name="AppTitleBar"
            x:Uid="WindowTitleBar">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                Spacing="20"
                Padding="28,24,28,32">
                <StackPanel Spacing="6">
                    <TextBlock
                        x:Uid="MainHeading"
                        Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock
                        x:Uid="MainBody"
                        MaxWidth="720"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid
                    ColumnSpacing="12"
                    RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:ConnectionId='7'
                        x:Uid="ElectronPathBox"
                        Grid.Row="0"
                        Grid.Column="0"
                        AutomationProperties.AutomationId="ElectronPathBox"
                                                                                                                   />

                    <TextBox x:ConnectionId='8'
                        x:Uid="AppPathBox"
                        Grid.Row="1"
                        Grid.Column="0"
                        AutomationProperties.AutomationId="AppPathBox"
                                                                                                            />

                    <Button x:ConnectionId='9'
                        x:Uid="PingBridgeButton"
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        MinWidth="160"
                        AutomationProperties.AutomationId="PingBridgeButton"
                                                                                    />
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ProgressRing x:ConnectionId='3'
                        Grid.Column="0"
                        Width="24"
                        Height="24"
                                                                          />

                    <StackPanel
                        Grid.Column="1"
                        Spacing="4">
                        <TextBlock x:ConnectionId='4'
                                                                              
                            Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock x:ConnectionId='5'
                                                                                
                            Style="{ThemeResource BodyTextBlockStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock x:ConnectionId='6'
                                                                               
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

